{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/porthos/get-configuration-output.json",
    "description": "Configure porthos",
    "examples": [
        {
            "source": "rsync://ftp.fau.de/rockylinux/",
            "check_sources": [
                "rsync://ftp.halifax.rwth-aachen.de/rockylinux/",
                "rsync://mirror.netzwerge.de/rocky-linux/"
            ],
            "retention": 30,
            "server_name": "updates.nethserver.org"
        }
    ],
    "type": "object",
    "properties": {
        "source": {
            "type": "string",
            "description": "Base rsync:// URL of the Rocky Linux tree, holding the 9/ directory, on an official mirror. The snapshot copies it."
        },
        "check_sources": {
            "type": "array",
            "description": "Base rsync:// URLs of the Rocky Linux tree on other official mirrors. A snapshot is accepted if one of them has the same contents as source. Empty disables the check.",
            "items": {
                "type": "string"
            }
        },
        "retention": {
            "type": "integer",
            "minimum": 1
        },
        "server_name": {
            "type": "string",
            "format": "idn-hostname"
        }
    }
}
